{
  "name": "@perry-rylance/midi-macros",
  "author": "Perry Rylance",
  "license": "MIT",
  "description": "Collection of functions to assist with composing MIDI from scratch with @perry-rylance/midi",
  "version": "0.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vitest",
    "test": "tsc && vitest run",
    "build": "npm run test",
    "prepublishOnly": "npm run build",
    "examples": "npx tsx examples/generate.ts && npx vite --config examples/vite.config.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryRylance/midi-macros.git"
  },
  "keywords": [
    "MIDI",
    "composition",
    "macros"
  ],
  "bugs": {
    "url": "https://github.com/PerryRylance/midi-macros/issues"
  },
  "homepage": "https://github.com/PerryRylance/midi-macros#readme",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "spessasynth_lib": "^4.3.14",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@perry-rylance/midi": "^1.2.1"
  }
}
